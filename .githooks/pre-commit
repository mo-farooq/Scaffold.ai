#!/usr/bin/env bash
# Git Pre-Commit Hook: Local Branch Protection & Syntax Validation for Scaffold.ai

set -e

current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

# Prevent direct commits to main
if [ "$current_branch" = "main" ]; then
  if [ "$ALLOW_MAIN_COMMIT" != "1" ]; then
    echo ""
    echo "🛑 Branch Protection: Direct commits to 'main' are blocked."
    echo "--------------------------------------------------------"
    echo "To keep 'main' stable and review-ready, please develop on a branch or worktree:"
    echo "  npm run worktree:add <feature-name>"
    echo "  # or: git checkout -b feat/<feature-name>"
    echo ""
    echo "If you must bypass this check in an emergency, use:"
    echo "  ALLOW_MAIN_COMMIT=1 git commit ..."
    echo ""
    exit 1
  fi
fi

# Run fast syntax checks across all scripts and test suites
echo "🔍 Running pre-commit validation (npm run check)..."
npm run check
